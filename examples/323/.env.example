# 이 파일은 무엇인가:
#   필요한 "비밀값"의 견본(자리표시자)입니다. 진짜 값은 절대 여기 적지 않습니다.
# 어떻게 쓰나:
#   1) 이 파일을 복사해 같은 폴더에 ".env" 라는 이름으로 만듭니다.
#   2) ".env" 안의 자리표시자를 진짜 값으로 바꿉니다.
#   3) ".env" 는 .gitignore 에 걸려 깃(GitHub)에 올라가지 않습니다 → 키가 새지 않습니다.
#
# 왜 키를 코드가 아니라 .env 에 두나 (★중요★):
#   ANTHROPIC_API_KEY 는 "비밀값"입니다. 이 키가 있으면 누구나 내 요금으로 Claude를 부를 수 있습니다.
#   그래서 server.js 같은 코드나 index.html(브라우저)에 절대 박지 않고, 서버만 읽는 .env 에 둡니다.

# Claude(Anthropic) API 키 — https://console.anthropic.com 에서 발급. (절대 공개 금지)
ANTHROPIC_API_KEY=sk-ant-여기에_진짜_키를_넣으세요

# (선택) 서버 포트. 비워 두면 3000번을 씁니다.
PORT=3000
