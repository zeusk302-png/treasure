# 이 파일은 무엇인가:
#   필요한 '비밀값의 견본'입니다. 진짜 값은 들어 있지 않습니다(자리표시자만).
# 쓰는 법:
#   이 파일을 복사해 .env 파일을 만들고, 아래 자리표시자를 진짜 값으로 바꾸세요.
#     cp .env.example .env
#   .env 는 .gitignore 로 깃에서 빠지므로, 진짜 키가 깃허브로 새지 않습니다.

# Claude API 키 — 절대 노출하면 안 되는 비밀값.
#   console.anthropic.com 의 API Keys 메뉴에서 발급받아 sk-ant-... 형태로 붙여넣으세요.
#   이 키는 server.js 만 읽으며, 브라우저(index.html)에는 절대 들어가지 않습니다.
ANTHROPIC_API_KEY=sk-ant-여기에-실제-키를-붙여넣으세요

# 서버 포트 — 공개되어도 되는 값. 비워 두면 3000 을 씁니다.
PORT=3000
