# =============================================================
# 이 파일은 무엇인가:
#   필요한 비밀값의 "견본"입니다. 진짜 값은 절대 여기 적지 마세요.
# 어떻게 쓰나:
#   이 파일을 복사해 .env 로 이름을 바꾸고, 아래 빈칸을 진짜 값으로 채우세요.
#   .env 는 .gitignore에 의해 깃에 안 올라갑니다(= 비밀 유지).
# 규칙:
#   아래 값들은 전부 "서버 전용 비밀값"입니다. 브라우저 코드/깃에 절대 박지 마세요.
# =============================================================

# Claude 답변 생성용 키. https://console.anthropic.com 에서 발급 (sk-ant-... 형태)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# 임베딩(글->벡터) 생성용 키. https://platform.openai.com 에서 발급 (sk-... 형태)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# Supabase 프로젝트 URL. Project Settings -> API 에서 복사 (https://xxxx.supabase.co)
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL_HERE

# Supabase service_role 키 (DB 마스터 키 = 비밀!). Project Settings -> API 에서 복사.
# 절대 브라우저로 보내지 말 것. 이 실습은 서버에서만 DB에 접근합니다.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# 서버 포트(선택). 비워두면 3000번을 씁니다.
PORT=3000
