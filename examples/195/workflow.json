        "assignments": {
          "assignments": [
            {
              "id": "aaaa0001-1111-4111-8111-aaaaaaaaaaaa",
              "name": "상태코드",
              "value": "={{ $json.statusCode }}",
              "type": "number"
            },
            {
              "id": "aaaa0002-2222-4222-8222-aaaaaaaaaaaa",
              "name": "응답살아있음",
              "value": "={{ $json.statusCode >= 200 && $json.statusCode < 400 }}",
              "type": "boolean"
            },
            {
              "id": "aaaa0003-3333-4333-8333-aaaaaaaaaaaa",
              "name": "title있음",
              "value": "={{ /<title[^>]*>[^<]+<\\/title>/i.test($json.body) }}",
              "type": "boolean"
            },
            {
              "id": "aaaa0004-4444-4444-8444-aaaaaaaaaaaa",
              "name": "description있음",
              "value": "={{ /<meta[^>]+name=[\"']description[\"'][^>]*>/i.test($json.body) }}",
              "type": "boolean"
            },
            {
              "id": "aaaa0005-5555-4555-8555-aaaaaaaaaaaa",
              "name": "lang있음",
              "value": "={{ /<html[^>]+lang=/i.test($json.body) }}",
              "type": "boolean"
            },
            {
              "id": "aaaa0006-6666-4666-8666-aaaaaaaaaaaa",
              "name": "alt없는이미지수",
              "value": "={{ ($json.body.match(/<img(?![^>]*\\balt=)[^>]*>/gi) || []).length }}",
              "type": "number"
            }
          ]
