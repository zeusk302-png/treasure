              "type": "string"
            },
            {
              "id": "c3c3c3c3-3333-4333-8333-cccccccccccc",
              "name": "메시지",
              "value": "={{ $json.body.message || '내용 없음' }}",
              "type": "string"
            },
            {
              "id": "d4d4d4d4-4444-4444-8444-dddddddddddd",
              "name": "받은시각",
              "value": "={{ $now.format('yyyy-MM-dd HH:mm:ss') }}",
              "type": "string"
            },
            {
              "id": "e5e5e5e5-5555-4555-8555-eeeeeeeeeeee",
              "name": "슬랙알림문구",
              "value": "=:email: *새 문의가 도착했습니다*\n\n*이름:* {{ $json.body.name || '이름 없음' }}\n*이메일:* {{ $json.body.email || '이메일 없음' }}\n*내용:* {{ $json.body.message || '내용 없음' }}\n\n받은 시각: {{ $now.format('yyyy-MM-dd HH:mm') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "22222222-2222-4222-8222-222222222222",
      "name": "문의 내용 정리하기 (Set)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        560,
        300
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "C0000000000",
          "mode": "id"
        },
        "text": "={{ $json.슬랙알림문구 }}",
        "otherOptions": {}
      },
      "id": "33333333-3333-4333-8333-333333333333",
      "name": "슬랙으로 알림 보내기 (Slack)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        800,
        220
      ],
      "credentials": {
        "slackApi": {
          "id": "REPLACE_WITH_YOUR_SLACK_CREDENTIAL_ID",
