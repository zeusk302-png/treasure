{
  "name": "205 - 문의 폼 제출 → 슬랙/메일 알림 받기",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "contact-form",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "11111111-1111-4111-8111-111111111111",
      "name": "문의 받기 (Webhook)",
