# =============================================================
#  이 파일은 무엇인가:
#  "이 앱을 어떤 환경에서 어떻게 실행할지"를 한 줄씩 적은 조립 설명서(Dockerfile)입니다.
#  도커는 이 설명서를 위에서 아래로 읽어 '이미지'(앱+실행환경을 통째로 담은 도장틀)를 굽고,
#  그 이미지로 '컨테이너'(실제로 도는 인스턴스)를 띄웁니다.
#
#  왜 있는가:
#  "내 컴퓨터에선 됐는데 서버에선 안 돼" 문제를 없애기 위해서입니다.
#  Node 버전·라이브러리·실행 명령까지 전부 이 파일에 박아 두면,
#  누구의 어떤 컴퓨터에서 빌드해도 똑같은 환경이 재현됩니다.
# =============================================================

# 1) 베이스 이미지: 맨바닥에서 시작하지 않고, Node.js 20이 이미 깔린 공식 이미지 위에서 시작합니다.
#    -slim 을 쓰는 이유 — 군더더기를 뺀 가벼운 버전이라 이미지 용량이 작고 빌드/배포가 빠릅니다.
FROM node:20-slim

# 2) 작업 디렉터리: 컨테이너 안에서 앞으로 명령이 실행될 기본 폴더를 /app 으로 정합니다.
#    (없으면 자동 생성됩니다. 파일이 여기저기 흩어지지 않게 한곳으로 모으는 정리정돈 목적입니다.)
WORKDIR /app

# 3) 의존성 명세부터 먼저 복사 — package.json 만 따로 먼저 복사하는 이유(중요한 최적화):
#    도커는 줄마다 결과를 '캐시'합니다. 소스코드가 바뀌어도 package.json 이 그대로면
#    아래 npm install 줄을 다시 실행하지 않고 캐시를 재사용해 빌드가 훨씬 빨라집니다.
COPY package*.json ./

# 4) 라이브러리 설치: 운영용으로만 설치합니다.
#    --omit=dev 를 쓰는 이유 — 테스트용 등 개발 전용 패키지는 빼서 이미지를 더 가볍고 안전하게 만듭니다.
RUN npm install --omit=dev

# 5) 나머지 앱 소스 전체 복사: server.js 등 실제 코드를 컨테이너 안으로 가져옵니다.
#    (.dockerignore 에 적은 node_modules·.env 등은 여기서 제외됩니다.)
COPY . .

# 6) 노출 포트 안내: "이 컨테이너는 3000번 문을 씁니다"라고 문서화하는 줄입니다.
#    (이 줄 자체가 포트를 여는 건 아니고, 실제 연결은 docker run 의 -p 옵션으로 합니다.)
EXPOSE 3000

# 7) 보안: root(관리자)로 앱을 돌리지 않습니다.
#    node 이미지에 기본 포함된 비관리자 사용자 'node'로 바꾸는 이유 —
#    혹시 앱이 뚫려도 컨테이너 안에서 할 수 있는 일을 최소화해 피해를 줄이기 위해서입니다.
USER node

# 8) 컨테이너가 시작될 때 실행할 명령: package.json 의 start 스크립트(= node server.js).
#    배열(exec) 형태로 쓰는 이유 — 종료 신호(Ctrl+C 등)가 앱에 제대로 전달되어 깔끔히 멈춥니다.
CMD ["npm", "start"]
