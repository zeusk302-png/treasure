# ============================================================
#  .env.example  —  "어떤 값이 필요한지" 알려주는 견본 파일
#
#  이 파일은 GitHub에 올라가도 됩니다. (진짜 값이 없으니까요)
#  실제로 쓸 때는 이 파일을 복사해서 ".env" 라는 이름으로 만들고
#  아래 자리표시자(여기에_붙여넣기)를 진짜 값으로 바꾸세요.
#
#  복사 방법 (한 줄 실행):
#     cp .env.example .env        (맥/리눅스/Git Bash)
#     copy .env.example .env      (윈도우 명령프롬프트)
# ============================================================


# ── 1) 공개해도 되는 값 (브라우저·프론트엔드에 박혀도 안전) ──
#  Supabase 프로젝트 주소 — 그냥 우리 집 주소 같은 것. 비밀 아님.
SUPABASE_URL=https://여기에_프로젝트_주소.supabase.co

#  anon(공개) 키 — "방문객 출입증". 누구나 볼 수 있게 설계된 공개 키입니다.
#  단, 이 키가 안전한 이유는 RLS(행 수준 보안)가 켜져 있을 때뿐입니다!
#  (RLS 설명은 README 와 docs/04-security/02.md 참고)
SUPABASE_ANON_KEY=여기에_anon_공개키_붙여넣기


# ── 2) 절대 숨겨야 하는 값 (서버에서만 사용, 브라우저·git 금지) ──
#  service_role(비밀) 키 — "마스터 키". RLS를 전부 무시하고 모든 데이터를
#  읽고 지울 수 있습니다. 유출되면 DB 전체가 털립니다.
#  → 브라우저 코드(index.html, script.js)에 절대 넣지 마세요.
#  → 서버(예: n8n, Edge Function, 백엔드)에서만 사용합니다.
SUPABASE_SERVICE_ROLE_KEY=여기에_service_role_비밀키_붙여넣기__브라우저에_절대_금지
