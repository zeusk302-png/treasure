# 실습 333 — 비밀값 견본 (자리표시자만! 진짜 값은 여기 적지 않습니다)
#
# 이 파일은 "어떤 비밀값이 필요한지"만 알려 주는 견본입니다. 깃에 올라가도 됩니다(진짜 값이 없으니까).
# 사용법: 이 파일을 복사해 .env 를 만들고, 거기에만 진짜 값을 적습니다.
#   - 맥/리눅스/Git Bash:  cp .env.example .env
#   - 윈도우 PowerShell:    Copy-Item .env.example .env
# .env 는 .gitignore 로 깃에서 제외되므로 절대 올라가지 않습니다.
# 배포할 땐 이 파일을 올리는 게 아니라, Vercel 등의 'Environment Variables(시크릿 저장소)'에
# 같은 이름의 키를 넣습니다. 코드(process.env.X)는 한 글자도 안 바뀝니다.

# ── 절대 숨겨야 하는 비밀값(서버 전용) ──────────────────────────────
# Claude(Anthropic) API 키. 형식은 sk-ant-... 입니다. 브라우저로 절대 내보내지 마세요.
CLAUDE_API_KEY=sk-ant-REPLACE_ME

# Stripe 시크릿 키. 테스트는 sk_test_..., 라이브는 sk_live_... 입니다. 결제를 움직이는 키라 최고 등급 비밀.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# 데이터베이스 접속 문자열(비밀번호 포함). 새면 DB 전체가 위험합니다.
DATABASE_URL=postgresql://USER:REPLACE_ME@HOST:5432/DBNAME

# Supabase service_role 키. RLS 를 우회하는 만능 키라 '서버 전용 비밀'입니다.
# (anon/publishable 키는 공개돼도 되는 값이라 여기 둘 필요 없습니다 — 그건 비밀이 아닙니다.)
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_service_role_key

# ── 공개돼도 되는 값(비밀 아님) ──────────────────────────────────
# 사이트 주소처럼 브라우저로 나가도 되는 값. 비밀이 아니라 기본값을 코드에 둬도 안전합니다.
# (Next.js 라면 브라우저로 내보낼 공개값에만 NEXT_PUBLIC_ 접두사를 붙입니다. 비밀값엔 절대 붙이지 마세요.)
PUBLIC_SITE_URL=http://localhost:3000
