# ============================================================
#  .env.example  —  "여기에 무엇이 들어가는지" 알려주는 견본 파일
# ============================================================
#  사용법: 이 파일을 복사해서 이름을 ".env" 로 바꾼 뒤,
#          오른쪽 자리표시자를 진짜 값으로 채우세요.
#
#  ⚠️ 규칙
#   - 이 .env.example 파일은 깃허브에 올려도 됩니다 (값이 가짜라서 안전).
#   - 진짜 값이 든 ".env" 파일은 절대! 깃허브에 올리지 마세요.
#     (.gitignore 에 ".env" 가 들어 있어야 합니다 → 가이드 04/03)
#   - 배포할 때 이 값들은 Vercel "Environment Variables" 화면에 입력합니다.
# ============================================================


# -----------------------------------------------------------------
# [공개해도 되는 값]  프론트엔드(브라우저)에 노출돼도 안전합니다.
#   - 누구나 볼 수 있는 "건물 주소"와 "방문객 출입증" 같은 것.
#   - 안전한 이유는 RLS(행 수준 보안)가 막아주기 때문 → 가이드 04/01, 04/02
# -----------------------------------------------------------------
SUPABASE_URL=https://REPLACE_WITH_YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_YOUR_PUBLIC_ANON_KEY


# -----------------------------------------------------------------
# [절대 숨겨야 하는 값]  서버(Edge Function)에서만 씁니다.
#   - 이건 "마스터키"입니다. 새어 나가면 모든 데이터가 위험.
#   - 절대 브라우저 코드(index.html, *.js)에 넣지 마세요.
#   - 절대 깃허브에 올리지 마세요. → 가이드 04/01, 04/05
# -----------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_YOUR_SECRET_SERVICE_ROLE_KEY

# AI 모델 호출용 비밀 키 (이것도 서버에서만! 브라우저 금지)
AI_API_KEY=YOUR_AI_API_KEY_HERE
