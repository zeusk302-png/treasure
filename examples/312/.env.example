# 실습 312 — 비밀값 견본 (자리표시자만! 진짜 값은 여기 적지 않습니다)
#
# 이 파일은 "어떤 값이 필요한지"만 알려 주는 견본입니다.
# 이 파일을 복사해 .env 를 만들고, 거기에만 진짜 값을 적습니다. .env 는 .gitignore 로 깃에서 빠집니다.
#   cp .env.example .env

# Meilisearch 서버 주소 — 로컬에서 도커로 띄우면 보통 이 값입니다(공개돼도 무방).
MEILI_HOST=http://localhost:7700

# Meilisearch 마스터 키 — 색인을 만들고 검색하는 '대문 열쇠'입니다.
# 절대 비밀! 브라우저(index.html)에 박지 말고 서버(server.js/seed.js)에서만 씁니다.
# 도커 실행 때 -e MEILI_MASTER_KEY="..." 로 준 값과 '똑같이' 적어야 합니다.
MEILI_MASTER_KEY=REPLACE_WITH_A_LONG_RANDOM_MASTER_KEY

# (선택) 우리 검색 서버가 열릴 포트. 비워 두면 3000 을 씁니다(공개돼도 무방).
PORT=3000
