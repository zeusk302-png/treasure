# 실습 180 — 비밀값 견본 (자리표시자만! 진짜 값은 여기 적지 않습니다)
#
# 이 파일은 "어떤 비밀값이 필요한지"만 알려 주는 견본입니다.
# 진짜 값은 n8n 의 Credentials / 환경변수, 또는 Vercel > Settings > Environment Variables 에만 넣습니다.
# 이 파일을 복사해 .env 를 만들고 거기에만 진짜 값을 적은 뒤, .env 는 절대 깃에 올리지 않습니다.

# 슬랙 수신 웹훅(Incoming Webhook) 주소 — 알림이 도착할 채널의 주소입니다.
# n8n 워크플로우의 '슬랙으로 보내기' 노드가 $env.SLACK_WEBHOOK_URL 로 이 값을 읽습니다.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE_WITH_YOUR_WEBHOOK_PATH

# 방문 통계를 읽을 때 쓰는 비밀 토큰 (Plausible API 키 등).
# 이 값은 n8n > Credentials 의 'Header Auth' 자격증명에 넣고 HTTP 노드에 연결합니다.
# (Authorization 헤더 형태 예: "Bearer <진짜토큰>")
ANALYTICS_API_TOKEN=plausible-or-vercel-read-token-PLACEHOLDER

# 통계를 읽어 올 주소 (도구/도메인에 맞게 바꾸세요)
# 예: https://plausible.io/api/v1/stats/aggregate?site_id=your-domain.com&period=day
ANALYTICS_STATS_URL=https://YOUR-DOMAIN.example.com/api/stats
