# 실습 328 — 비밀값/설정 견본 (자리표시자만! 진짜 값은 여기 적지 않습니다)
#
# 이 파일은 "어떤 값이 필요한지"만 알려 주는 견본입니다.
# 복사해 .env 를 만들고 거기에만 진짜 값을 적은 뒤, .env 는 절대 깃에 올리지 않습니다.
# (배포할 때는 Vercel/Netlify 등의 Environment Variables 화면에 넣습니다.)

# Supabase 프로젝트 주소 — 공개되어도 되는 값입니다.
# Supabase 대시보드 > Project Settings > API > Project URL 에서 복사합니다.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# anon(공개) 키 — 브라우저에 나가도 되는 공개 값입니다.
# 진짜 보호는 RLS/Storage 정책이 합니다. ("anon 키 = 비밀번호" 는 틀린 설명입니다.)
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# ⚠️ service_role 키 — 절대 비밀! 브라우저/깃에 두면 안 됩니다.
# RLS·정책을 전부 무시하는 마스터 키라, 서버(또는 Edge Function/n8n)에서만 씁니다.
# 이번 프론트 실습에서는 쓰지 않지만, 서버에서 쓸 일이 생기면 이 자리에만 보관하세요.
SUPABASE_SERVICE_ROLE_KEY=DO_NOT_PUT_REAL_VALUE_HERE_server_only

# 사용할 Storage 버킷 이름 (Supabase 에서 만든 이름과 같아야 합니다)
SUPABASE_BUCKET=images
