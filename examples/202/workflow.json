{
  "name": "202 - 매일 아침 오늘 날씨를 이메일로 받기",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 7,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "11111111-1111-4111-8111-111111111111",
      "name": "매일 오전 7시 (Schedule Trigger)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        320,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://api.open-meteo.com/v1/forecast",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "latitude",
              "value": "35.18"
            },
            {
              "name": "longitude",
              "value": "129.08"
            },
            {
              "name": "daily",
              "value": "temperature_2m_max,temperature_2m_min,precipitation_probability_max"
            },
            {
              "name": "timezone",
              "value": "Asia/Seoul"
            },
            {
              "name": "forecast_days",
              "value": "1"
            }
          ]
        },
        "options": {}
      },
      "id": "22222222-2222-4222-8222-222222222222",
      "name": "오늘 날씨 가져오기 (HTTP Request)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1a1a1a1-1111-4111-8111-aaaaaaaaaaaa",
              "name": "제목",
              "value": "=오늘({{ $json.daily.time[0] }}) 부산 날씨 알림",
              "type": "string"
            },
            {
              "id": "b2b2b2b2-2222-4222-8222-bbbbbbbbbbbb",
              "name": "본문",
              "value": "=좋은 아침입니다!\n\n오늘({{ $json.daily.time[0] }}) 부산 날씨를 알려드립니다.\n\n- 최고기온: {{ $json.daily.temperature_2m_max[0] }}도\n- 최저기온: {{ $json.daily.temperature_2m_min[0] }}도\n- 비 올 확률: {{ $json.daily.precipitation_probability_max[0] }}%\n\n비 올 확률이 높으면 우산을 챙기세요. 좋은 하루 되세요!",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "33333333-3333-4333-8333-333333333333",
      "name": "메일 내용 만들기 (Set)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        800,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "YOUR_SENDER_EMAIL@example.com",
        "toEmail": "YOUR_RECEIVER_EMAIL@example.com",
        "subject": "={{ $json.제목 }}",
        "emailFormat": "text",
        "text": "={{ $json.본문 }}",
        "options": {}
      },
      "id": "44444444-4444-4444-8444-444444444444",
      "name": "메일 보내기 (Send Email)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1040,
        300
      ],
      "credentials": {
        "smtp": {
          "id": "REPLACE_WITH_YOUR_SMTP_CREDENTIAL_ID",
          "name": "내 메일 계정 (SMTP)"
        }
      }
    }
  ],
  "connections": {
    "매일 오전 7시 (Schedule Trigger)": {
      "main": [
        [
          {
            "node": "오늘 날씨 가져오기 (HTTP Request)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "오늘 날씨 가져오기 (HTTP Request)": {
      "main": [
        [
          {
            "node": "메일 내용 만들기 (Set)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "메일 내용 만들기 (Set)": {
      "main": [
        [
          {
            "node": "메일 보내기 (Send Email)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
