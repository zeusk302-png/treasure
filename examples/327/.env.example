# 실습 327 — 비밀값 견본 (자리표시자만! 진짜 값은 여기 적지 않습니다)
#
# 이 파일은 "어떤 비밀값이 필요한지"만 알려 주는 견본입니다.
# 사용법: 이 파일을 복사해 .env 를 만들고, .env 에만 진짜 값을 적습니다.
# .env 는 .gitignore 덕분에 깃에 올라가지 않습니다. (이 .env.example 견본만 깃에 올립니다.)
# 배포 시에는 배포 서비스(예: Render/Railway/Vercel)의 Environment Variables 에 같은 값을 넣습니다.

# Resend 이메일 API 비밀 키. 're_' 로 시작합니다.
# 절대 비밀: 노출되면 남이 내 계정으로 메일을 보낼 수 있습니다. 그래서 server.js 가 process.env 로만 읽습니다.
RESEND_API_KEY=re_REPLACE_WITH_YOUR_RESEND_API_KEY

# 발신 주소(보낸사람). 도메인 인증 전에는 Resend 테스트 주소를 권장합니다.
# 인증 후에는 hello@내도메인.com 처럼 내 도메인 주소로 바꿀 수 있습니다(스팸함 회피에 유리).
MAIL_FROM=onboarding@resend.dev

# (선택) 운영자(나)에게도 "새 문의 도착" 사본을 받고 싶을 때, 받을 주소.
# 비워 두면 신청자 확인 메일만 보내고 운영자 사본은 건너뜁니다.
OWNER_EMAIL=

# (선택) 서버 포트. 비우면 3000번을 씁니다.
PORT=3000
