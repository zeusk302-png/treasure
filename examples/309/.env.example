# .env.example — 견본(자리표시자만). 이 파일을 복사해 .env 를 만들고 진짜 값을 넣으세요.
# 왜: 진짜 .env 는 .gitignore 로 깃에서 빠지므로, 비밀값이 저장소에 올라가지 않습니다.

# 서버가 열릴 포트. 비밀 아님(원하는 숫자로).
PORT=3000

# Redis 접속 주소.
# - 로컬 Docker로 띄운 비밀번호 없는 Redis면 아래 기본값 그대로 두면 됩니다(비밀 아님).
# - 클라우드 Redis(Upstash 등)처럼 비밀번호가 포함된 주소라면, 그 주소 전체가 사실상 비밀입니다.
#   → 진짜 주소는 .env(또는 배포 플랫폼 시크릿)에만 넣고, 코드/깃에는 절대 박지 마세요.
REDIS_URL=redis://127.0.0.1:6379
# 비밀번호 있는 예시 형태(자리표시자): redis://default:REPLACE_WITH_PASSWORD@your-host:6379
