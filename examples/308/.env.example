# ───────────────────────────────────────────────────────────
# .env.example — 환경변수 견본 (자리표시자만! 진짜 값 적지 말 것)
# 사용법: 이 파일을 복사해 .env 로 만들고, 아래 값에 진짜 정보를 채운다.
#   cp .env.example .env
# .env 는 .gitignore 로 깃에 안 올라간다(비밀 보호).
# ───────────────────────────────────────────────────────────

# Redis 접속 주소 — ★비밀값★ (비밀번호가 들어갈 수 있어 절대 코드/깃에 박지 않는다)
#  - 로컬 Docker/설치:  redis://localhost:6379
#  - Upstash 등 클라우드(TLS):  rediss://default:<비밀번호>@<호스트>:<포트>
REDIS_URL=redis://localhost:6379

# 레이트리밋 설정(공개되어도 무방하지만, 환경별로 바꾸기 쉽게 여기에 둔다)
RATE_LIMIT_MAX=10          # 한 창(window) 동안 허용할 요청 횟수
RATE_LIMIT_WINDOW_SEC=60   # 창 길이(초). 60이면 "1분에 RATE_LIMIT_MAX회"

# 서버 포트(선택)
PORT=3000
