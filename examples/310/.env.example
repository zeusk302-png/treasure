# 실습 310 — 환경변수 견본 (자리표시자만! 진짜 값은 여기 적지 않습니다)
#
# 이 실습에는 사실 "비밀값(API 키/토큰)"이 없습니다. 채팅 서버는 외부 비밀에 의존하지 않으니까요.
# 다만 "포트/방 이름" 같은 설정을 코드에 박지 않고 환경변수로 빼 두는 습관을 보여 주려고 이 파일을 둡니다.
#
# 쓰는 법: 이 파일을 복사해 .env 를 만들고 값만 바꾸세요. .env 는 .gitignore 로 깃에서 빠집니다.
# (배포 플랫폼에서는 이 값들을 Settings > Environment Variables 에 넣습니다.)

# 서버가 열릴 포트. 비워 두면 server.js가 3000을 씁니다. (비밀이 아니라 그냥 설정값)
PORT=3000

# 채팅방 표시 이름. 화면에 보이는 라벨일 뿐이라 공개돼도 됩니다.
ROOM_NAME=공개 라운지

# 참고: 만약 나중에 이 서버에 "비밀값"(예: 인증 토큰)을 더한다면,
#       반드시 이런 .env 에만 두고 코드/깃에는 올리지 않습니다. 클라이언트(index.html)에는 절대 두지 않습니다.
