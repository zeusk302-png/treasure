# .env.example — "공개해도 되는 견본" 파일 (값은 모두 비움)
#
# 이 파일은 깃허브에 올라가도 안전합니다. 진짜 값은 하나도 없고,
# "어떤 이름의 값이 필요한지"만 알려주는 견본이기 때문입니다.
#
#   cp .env.example .env.local      (윈도우: copy .env.example .env.local)
#
# 이번 실습(299)의 점검 표는 바로 이 "이름과 접두"를 근거로 판정합니다.
#  - VITE_ 접두가 붙은 값만 브라우저(화면)로 노출됩니다. = "공개돼도 되는 값"
#  - 접두가 없는 SUPABASE_SERVICE_ROLE_KEY 는 절대 브라우저로 안 보냅니다. = "비밀"

# ── 공개돼도 되는 값(브라우저에 노출 OK) ─────────────────────────
# anon(publishable) 키: "공개돼도 되는 출입증". 화면에 있어도 괜찮습니다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── 절대 비밀(브라우저·깃허브 금지, 서버에서만) ──────────────────
# service_role(secret) 키: RLS를 통째로 우회하는 마스터키.
# VITE_ 접두를 절대 붙이지 않습니다(붙이면 브라우저로 새어 🔴).
# 서버(api/) 코드에서 process.env 로만 읽습니다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
