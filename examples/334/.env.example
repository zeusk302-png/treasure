# 이 파일은 무엇인가:
# 이 데모에 필요한 "설정값 견본"입니다. 이 파일(.env.example)은 자리표시자만 들어 있어
# 깃에 올려도 안전합니다. 실제로 쓸 땐 이 파일을 복사해 .env 를 만들고, 거기에 진짜 값을 넣으세요.
# .env 는 .gitignore 로 깃에서 빠지므로, 비밀값이 실수로 공개되지 않습니다.

# 로그 최소 레벨: debug | info | warn | error
# (개발 땐 debug로 자세히, 운영 땐 info 이상으로 소음을 줄입니다 — 비밀값 아님)
LOG_LEVEL=info

# 서버 포트 (비밀값 아님)
PORT=3000

# 에러 추적 도구(Sentry)의 DSN 주소.
# ★ 비밀값입니다 — 코드나 깃에 절대 박지 말고 .env 에만 두세요.
# 비워 두면 데모는 콘솔로만 "보고"합니다. 진짜 Sentry를 쓰려면 발급받은 DSN을 넣으세요.
SENTRY_DSN=
