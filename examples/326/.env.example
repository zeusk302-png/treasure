# 실습 326 — 비밀값 견본 (자리표시자만! 진짜 값은 여기 적지 않습니다)
#
# 이 파일은 "어떤 비밀값이 필요한지"만 알려 주는 견본입니다.
# 진짜 값은 이 파일을 복사해 만든 .env 에만 적고, .env 는 절대 깃에 올리지 않습니다(.gitignore 가 막아 줍니다).
# 배포할 때는 Vercel/Render 등의 'Environment Variables' 화면에만 진짜 값을 넣습니다.

# Stripe 비밀 키 — 결제·환불 등 '돈을 움직이는' 권한이 있는 서버 전용 비밀값입니다.
# 절대 브라우저(프론트 코드)로 내보내면 안 됩니다. 노출되면 누구나 우리 계정으로 결제를 만질 수 있습니다.
# (테스트 단계에서는 sk_test_... 로 시작하는 '테스트 키'를 씁니다.)
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_SECRET_KEY

# 웹훅 시크릿 — Stripe 가 보낸 통보가 '진짜 Stripe 것'인지 서명으로 검증할 때 쓰는 비밀입니다.
# Stripe 대시보드에서 웹훅 엔드포인트를 만들면(또는 stripe CLI 로 listen 하면) whsec_... 값을 줍니다.
# 이 값이 없거나 틀리면 서명 검증이 실패해 모든 통보를 거절하게 됩니다.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET

# (선택) 서버 포트 — 비워 두면 server.js 가 4242 를 씁니다.
PORT=4242
