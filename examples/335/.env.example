# 실습 335 — 비밀값/설정 견본 (자리표시자만! 진짜 값은 여기 적지 않습니다)
#
# 이 파일은 "어떤 값이 필요한지"만 알려 주는 견본입니다.
# 이 파일을 복사해 .env 를 만들고 거기에만 진짜 값을 적습니다. .env 는 .gitignore 로 깃에서 빠집니다.
# 배포할 때는 .env 를 올리는 게 아니라, 플랫폼의 'Environment Variables' 화면에 같은 값을 넣습니다.

# 서버가 들을 포트. 보통 배포 플랫폼이 자기 포트를 PORT로 넣어 주므로 로컬에서만 바꾸면 됩니다.
# 비밀값 아님(공개돼도 무해) — 그래도 '코드에 박지 말고 환경변수로'의 습관을 위해 여기 둡니다.
PORT=3000

# 고장 알림 테스트용 스위치. 1로 두면 /health 가 일부러 503(고장)을 돌려줍니다.
# 평소엔 비워 두거나 0. "정말로 다운 알림이 오나?"를 시험할 때만 잠깐 1로 켭니다.
FORCE_DB_DOWN=

# (실제 프로젝트로 확장할 때) 헬스체크가 점검할 DB 접속 문자열.
# ★ 이건 진짜 비밀값입니다 — 절대 코드(server.js)나 깃에 넣지 말고 .env / 배포 플랫폼 환경변수에만 두세요.
# 예: postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# (선택) 헬스체크 주소를 외부에 함부로 노출하기 싫을 때 쓰는 비밀 경로 토큰.
# 모니터 URL을 /health 대신 /health?token=... 형태로 보호하고 싶을 때 사용. 진짜 비밀값입니다.
HEALTH_SECRET=replace-with-a-long-random-string
