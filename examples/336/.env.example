# 실습 336 — 환경값 견본 (자리표시자만! 진짜 값은 여기 적지 않습니다)
#
# 이 파일은 "어떤 값이 필요한지"만 알려 주는 견본입니다.
# 복사해서 .env 를 만들고, 진짜 값은 .env 에만 적으세요. .env 는 .gitignore 로 깃에서 빠집니다.
# (이 실습 자체는 비밀값이 거의 없지만, 대상 주소나 인증이 필요한 API를 때릴 때를 위한 견본입니다.)

# 부하를 줄 대상 주소. 반드시 "내 것"만! (남의 서버 금지)
# k6 스크립트(load-test.js)가 __ENV.BASE_URL 로 이 값을 읽습니다.
BASE_URL=http://localhost:3000

# 때릴 경로. 가벼운 길은 "/", 일부러 느린 길은 "/slow" — 비교 학습용입니다.
TARGET_PATH=/

# (선택) 인증이 필요한 내 API를 때릴 때만 사용하는 토큰.
# 이런 비밀 토큰은 절대 코드에 박지 말고 .env 에만 두세요. (anon 같은 공개키와 달리 이건 숨겨야 하는 값)
# 예: AUTH_TOKEN=Bearer YOUR_REAL_TOKEN_PLACEHOLDER
AUTH_TOKEN=
