# 비밀/환경 값은 깃허브에 올리지 않습니다
.env.local

# (참고) 그 외 흔히 비밀이 들어가는 환경 파일들도 함께 막아두면 안전합니다.
.env
.env.*.local

# ⚠️ 단, .env.example 은 일부러 올립니다 (값이 비어 있어 안전한 견본).
#    위의 .env / .env.*.local 규칙이 .env.example 을 막지 않도록,
#    아래 한 줄로 "이 파일은 예외(추적함)"라고 명시해 둡니다.
!.env.example

# 의존성/빌드 산출물 (참고용)
node_modules/
dist/
