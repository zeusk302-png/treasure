# .env.example — "공개해도 되는 견본" 파일
#
# 이 파일은 깃허브에 올라가도 안전합니다. 진짜 값은 하나도 없고,
# "어떤 이름의 값이 필요한지"만 알려주는 견본(템플릿)이기 때문입니다.
#
# 팀에 새로 합류한 사람은 이 파일을 .env.local 로 복사한 뒤,
# 오른쪽 자리표시자 자리에 본인 Supabase 값을 채워 넣으면 됩니다.
#
#   cp .env.example .env.local      (윈도우: copy .env.example .env.local)
#
# 규칙:
#  - 값은 절대 적지 않습니다. 모두 "여기에 채우세요" 식의 자리표시자입니다.
#  - VITE_ 접두가 붙은 값만 브라우저(화면)로 노출됩니다. = "공개돼도 되는 값"
#  - 접두가 없는 값(아래 SUPABASE_SERVICE_ROLE_KEY)은 절대 브라우저로 보내지 않습니다. = "비밀"

# ── 공개돼도 되는 값(브라우저에 노출 OK) ─────────────────────────
# anon(publishable) 키: "공개돼도 되는 출입증". 화면에 있어도 괜찮습니다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── 절대 비밀(브라우저·깃허브 금지) ──────────────────────────────
# service_role(secret) 키: RLS를 통째로 우회하는 마스터키.
# 정적 사이트(브라우저)에는 절대 두지 않습니다. 서버 환경에서만 사용.
# 견본 파일에도 진짜 값은 절대 넣지 않습니다. (이름만 남겨 둠)
SUPABASE_SERVICE_ROLE_KEY=
