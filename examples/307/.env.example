# 실습 307 — 비밀값 견본 (자리표시자만! 진짜 값은 여기 적지 않습니다)
#
# 이 파일은 "어떤 비밀값이 필요한지"만 알려 주는 견본입니다.
# 이 파일을 복사해 .env 를 만들고, 진짜 값은 .env 에만 적습니다.
# .env 는 .gitignore 로 깃에서 제외되므로 절대 커밋되지 않습니다.

# Redis 접속 주소 — 서버 전용 비밀값입니다(브라우저로 절대 나가면 안 됨).
# 로컬 Docker로 띄웠다면: redis://localhost:6379
# 클라우드(Upstash 등)면 아이디·비번이 포함된 주소가 발급됩니다(예: rediss://default:비번@호스트:포트).
REDIS_URL=redis://localhost:6379

# 쿠키 서명용 비밀키 — 쿠키 위조를 막는 데 씁니다. 아무에게도 알려 주지 마세요.
# 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# (선택) 세션 유효 시간(초). 데모는 만료를 눈으로 보기 쉽게 짧게 둡니다. 기본 300초(5분).
SESSION_TTL_SECONDS=300

# (선택) 서버 포트. 비워 두면 3000번을 씁니다.
PORT=3000
