# =============================================================
# 무엇: 이 실습에서 쓰는 Supabase 값들의 "견본"(자리표시자만).
# 왜:   진짜 값은 이 파일이 아니라 복사본 .env 에만 적는다. .env 는 .gitignore로 깃에서 빠진다.
# 쓰는 법: 이 파일을 .env 로 복사한 뒤, 아래 자리표시자를 내 프로젝트 값으로 바꾼다.
#          (이 정적 실습은 index.html에 anon 값을 직접 적어도 동작한다. 이 .env는 빌드 도구/
#           서버를 붙일 때를 대비한 견본이자, "비밀값을 어디에 두는지"를 익히는 연습이다.)
# =============================================================

# 프로젝트 URL — 공개돼도 되는 값(주소일 뿐).
SUPABASE_URL=https://여기에-내-프로젝트.supabase.co

# anon(publishable) 키 — ★공개돼도 되는 값★. 브라우저에 나가도 안전하다.
# 진짜 보호는 DB의 RLS(schema.sql)가 한다.
SUPABASE_ANON_KEY=sb_publishable_여기에-내-anon-키

# service_role 키 — ★절대 비밀★. 이 키는 RLS를 통째로 무시하므로 브라우저/깃에 절대 두면 안 된다.
# 이 실습(브라우저만 쓰는 정적 페이지)에는 필요 없다. 서버 작업을 붙일 때만, 서버 환경변수에만 둔다.
# SUPABASE_SERVICE_ROLE_KEY=절대_깃에_올리지_말것_서버에서만_사용
