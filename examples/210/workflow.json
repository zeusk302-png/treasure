{
  "name": "210 - 여러 건을 반복 처리하기 (Loop / Split In Batches)",
  "nodes": [
    {
      "parameters": {},
      "id": "11111111-1111-4111-8111-111111111111",
      "name": "수동 실행 (Manual Trigger)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -160,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// 실제로는 API(HTTP Request)나 구글 시트/Supabase에서 받아온\n// '여러 건의 목록'이라고 생각하세요. 여기서는 연습용으로 직접 5건을 만듭니다.\n// 각 item 은 n8n 에서 한 줄(한 건)의 데이터입니다.\nconst orders = [\n  { 주문번호: 'A-1001', 고객명: '김민수', 금액: 12000 },\n  { 주문번호: 'A-1002', 고객명: '이서연', 금액: 8500 },\n  { 주문번호: 'A-1003', 고객명: '박지훈', 금액: 30000 },\n  { 주문번호: 'A-1004', 고객명: '최유진', 금액: 5000 },\n  { 주문번호: 'A-1005', 고객명: '정현우', 금액: 21000 }\n];\n\n// n8n 은 '배열의 각 원소 = 한 건(item)' 으로 다룹니다.\n// 아래처럼 { json: ... } 형태로 감싸서 내보내면, 5건의 item 이 됩니다.\nreturn orders.map((order) => ({ json: order }));"
      },
      "id": "22222222-2222-4222-8222-222222222222",
      "name": "처리할 목록 만들기 (5건)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        60,
        300
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {
          "reset": false
        }
      },
      "id": "33333333-3333-4333-8333-333333333333",
      "name": "한 건씩 반복 (Loop Over Items)",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        300,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "aa11aa11-1111-4111-8111-aaaaaaaaaaaa",
              "name": "주문번호",
              "value": "={{ $json.주문번호 }}",
              "type": "string"
            },
            {
              "id": "bb22bb22-2222-4222-8222-bbbbbbbbbbbb",
              "name": "고객명",
              "value": "={{ $json.고객명 }}",
              "type": "string"
            },
            {
              "id": "cc33cc33-3333-4333-8333-cccccccccccc",
              "name": "금액",
              "value": "={{ $json.금액 }}",
              "type": "number"
            },
            {
              "id": "dd44dd44-4444-4444-8444-dddddddddddd",
              "name": "등급",
              "value": "={{ $json.금액 >= 20000 ? 'VIP' : '일반' }}",
              "type": "string"
            },
            {
              "id": "ee55ee55-5555-4555-8555-eeeeeeeeeeee",
              "name": "처리메시지",
              "value": "=주문 {{ $json.주문번호 }} ({{ $json.고객명 }}님, {{ $json.금액 }}원) 처리 완료",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "44444444-4444-4444-8444-444444444444",
      "name": "한 건 처리하기 (Set)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        560,
        200
      ]
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "options": {}
      },
      "id": "55555555-5555-4555-8555-555555555555",
      "name": "처리 결과 모으기 (Aggregate)",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        560,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "// Loop 가 끝나면 이 노드로 모든 결과가 한꺼번에 들어옵니다.\n// 위 Aggregate 노드가 모든 건을 data 라는 배열 하나로 묶어 줍니다.\nconst rows = $json.data || [];\n\nconst 총건수 = rows.length;\nconst 총금액 = rows.reduce((sum, r) => sum + (Number(r.금액) || 0), 0);\nconst VIP건수 = rows.filter((r) => r.등급 === 'VIP').length;\n\nreturn [{\n  json: {\n    제목: '반복 처리 결과 보고',\n    총건수,\n    VIP건수,\n    일반건수: 총건수 - VIP건수,\n    총금액,\n    요약문: `총 ${총건수}건을 처리했습니다. (VIP ${VIP건수}건 / 일반 ${총건수 - VIP건수}건, 합계 ${총금액.toLocaleString()}원)`\n  }\n}];"
      },
      "id": "66666666-6666-4666-8666-666666666666",
      "name": "건수 합산해 보고하기 (Code)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
