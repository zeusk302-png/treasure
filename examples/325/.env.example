# 실습 325 — 비밀값 견본 (자리표시자만! 진짜 값은 여기 적지 않습니다)
#
# 사용법: 이 파일을 복사해 .env 를 만들고, 거기에만 진짜 값을 적습니다.
#         .env 는 .gitignore 로 깃에서 빠지므로 키가 새어 나가지 않습니다.

# Stripe 시크릿 키 (sk_test_... 로 시작하는 '테스트' 키).
# ⚠️ 절대 비밀: 결제를 일으킬 수 있는 진짜 열쇠라 브라우저/프론트에 두면 안 됩니다.
#    오직 서버(server.js)에서만 읽습니다. Stripe 대시보드 > Developers > API keys 에서 발급.
#    실습 단계에선 반드시 'sk_test_'(테스트)만 씁니다. 라이브 키('sk_live_')는 진짜 돈이 빠집니다.
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_TEST_SECRET_KEY

# 결제가 끝나고 손님을 돌려보낼 우리 사이트 기본 주소.
# 로컬에선 아래처럼 두고, 배포하면 진짜 도메인(https://my-shop.example.com)으로 바꿉니다.
SITE_URL=http://localhost:3000

# 서버가 들을 포트 (안 적으면 3000).
PORT=3000

# 참고: 공개키(pk_test_...)는 '공개되어도 되는' 값이라 비밀이 아닙니다.
#       이번 실습은 서버가 결제 페이지 URL을 직접 만들어 주므로 공개키를 따로 쓰지 않습니다.
#       (Stripe.js를 프론트에서 직접 쓰는 방식으로 확장하면 그때 pk_test_ 가 필요해집니다.)
