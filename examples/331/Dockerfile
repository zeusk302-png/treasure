# =============================================================================
# 이 파일은 무엇인가:
#   Dockerfile — web(Node.js 앱)을 "컨테이너 이미지"로 굽는 설명서입니다.
#   한 줄 한 줄이 "이 환경 위에, 이걸 깔고, 이렇게 실행해"라는 빌드 단계입니다.
# 왜 있는가:
#   내 PC에 Node를 어떤 버전으로 깔았든 상관없이, 누구의 컴퓨터에서도
#   '똑같은 Node 환경'에서 앱이 돌게 하려고 환경 자체를 코드로 박제합니다.
# =============================================================================

# 베이스 이미지: Node.js 20의 가벼운 alpine 버전.
# 버전을 20으로 고정하는 이유: "latest"는 어느 날 바뀌어 동작이 달라질 수 있어
# 재현성을 위해 숫자로 못 박습니다. alpine은 용량이 작아 빌드가 빠릅니다.
FROM node:20-alpine

# 컨테이너 안에서 작업할 폴더를 /app으로 정합니다.
# 이후 명령들은 이 폴더 기준으로 실행됩니다.
WORKDIR /app

# 먼저 package.json만 복사해 의존성을 설치합니다.
# 왜 소스 전체보다 package.json을 먼저 복사하나:
#   Docker는 단계를 캐시합니다. 소스만 바뀌고 의존성 목록이 그대로면
#   npm install 단계를 캐시에서 재사용해 빌드가 훨씬 빨라집니다.
COPY package*.json ./
RUN npm install

# 나머지 앱 소스를 복사합니다.
# (개발 중에는 docker-compose.yml의 bind mount가 이 위를 덮어써,
#  코드를 고치면 이미지를 다시 굽지 않아도 바로 반영됩니다.)
COPY . .

# 이 앱이 컨테이너 안에서 3000 포트를 쓴다는 표시(문서화 목적).
# 실제 외부 연결은 docker-compose.yml의 ports가 담당합니다.
EXPOSE 3000

# 컨테이너가 시작될 때 실행할 명령.
# package.json의 "start" 스크립트(nodemon으로 server.js 실행)를 돌립니다.
CMD ["npm", "start"]
