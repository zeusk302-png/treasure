# =============================================================================
# 이 파일은 무엇인가:
#   .env.example — 필요한 환경변수의 "견본"입니다(진짜 값이 아니라 자리표시자).
# 어떻게 쓰는가:
#   이 파일을 복사해 같은 폴더에 ".env"로 저장하고 값을 채우세요.
#     PowerShell: Copy-Item .env.example .env
#     macOS/Linux: cp .env.example .env
# 왜 이렇게 나누나:
#   진짜 값이 든 .env는 .gitignore로 깃에서 빠지고, 견본인 이 파일만 깃에 올라갑니다.
#   → 비밀번호를 코드/깃에 노출하지 않으면서, 팀원에게 "어떤 값이 필요한지"는 알려줍니다.
# 보안 메모:
#   아래는 '로컬 개발용' 기본값이라 그대로 써도 큰 문제는 없지만,
#   실제 운영(클라우드) DB의 비밀번호는 절대 이런 식으로 적지 말고
#   배포 플랫폼의 시크릿 저장소에 넣으세요.
# =============================================================================

# Postgres 관리자 계정 이름
POSTGRES_USER=postgres

# Postgres 비밀번호 — 로컬 실습용 자리표시자입니다. 운영에서는 강한 값으로 바꾸세요.
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DEV_PASSWORD

# 만들 데이터베이스 이름
POSTGRES_DB=appdb
