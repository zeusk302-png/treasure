# ============================================================
#  .env.example — 환경변수 "견본" 파일 (자리표시자만 들어 있음)
#
#  이 파일은 GitHub에 올라가도 됩니다. 진짜 값이 없기 때문입니다.
#  진짜 값은 Vercel 대시보드(Settings → Environment Variables)에
#  Production / Preview 칸을 나눠서 등록합니다. (코드에 박지 않습니다.)
#
#  아래 두 변수는 "이름은 같고 값만 환경마다 다르게" 등록하는 예시입니다.
#  - Production 으로 등록할 값: 실서비스(진짜 데이터) Supabase 프로젝트의 값
#  - Preview    로 등록할 값: 연습용(테스트 데이터) Supabase 프로젝트의 값
# ============================================================

# 실서비스(Production)로 등록할 값 — 진짜 데이터가 사는 프로젝트
# Vercel 환경변수: Name=SUPABASE_URL,      Environment=Production
SUPABASE_URL=https://실서비스-프로젝트ID.supabase.co
# Vercel 환경변수: Name=SUPABASE_ANON_KEY, Environment=Production
SUPABASE_ANON_KEY=<실서비스_프로젝트의_anon_공개키_여기에>

# 미리보기(Preview)로 등록할 값 — 연습 데이터가 사는 별도 프로젝트
# (실제 Vercel에서는 같은 이름 SUPABASE_URL / SUPABASE_ANON_KEY 를
#  Environment=Preview 로 한 번 더 등록합니다. 아래 두 줄은 그 '값'의 예시.)
# SUPABASE_URL(Preview)      = https://연습용-프로젝트ID.supabase.co
# SUPABASE_ANON_KEY(Preview) = <연습용_프로젝트의_anon_공개키_여기에>

# ⚠️ service_role(비밀) 키는 절대 여기 두지 않습니다.
#    꼭 필요하면 SUPABASE_SERVICE_ROLE_KEY 라는 별도 이름으로 등록하되,
#    브라우저로 내려보내지 말고 서버 측 함수에서만 process.env 로 읽어 씁니다.
# SUPABASE_SERVICE_ROLE_KEY=<여기에_실제_비밀키_절대_커밋_금지>
